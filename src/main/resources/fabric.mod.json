{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "authors": ["${mod_author}"],
  "contact": {},
  "license": "${mod_license}",
  "description": "${mod_description}",
  "environment": "*",
  "entrypoints": {
    "main": ["org.liquidphase.LiquidPhase"],
    "client": ["org.liquidphase.client.LiquidPhaseClient"]
  },
  "mixins": [
    "liquidphase.mixins.json"${extra_mixins}${extra_mixins_26}
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${mc_dependency}",
    "fabric-api": "*"${statement_depends}
  }
}
